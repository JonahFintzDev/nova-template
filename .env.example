# Production environment variables
# Copy this to .env and fill in the values

# JWT Secret - generate a secure random string
JWT_SECRET=your-super-secure-jwt-key-change-this

# NextAuth.js Secret - generate a secure random string
NEXTAUTH_SECRET=your-secure-nextauth-secret-change-this

# NextAuth.js URL for callback URLs
NEXTAUTH_URL=http://localhost:3000

# Database URL (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/runnova?schema=public

# For development with SQLite (optional):
# DATABASE_URL=file:./app/api/data/prod.db
