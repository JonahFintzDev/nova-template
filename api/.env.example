# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/runnova?schema=public"

# For development with SQLite (optional):
# DATABASE_URL="file:./dev.db"

# API
PORT=3000
NODE_ENV=development

# JWT Secret (generate a secure random string)
JWT_SECRET=your-super-secret-jwt-key-change-this

# NextAuth.js Configuration
NEXTAUTH_SECRET=your-secure-nextauth-secret-change-this
NEXTAUTH_URL=http://localhost:3000

# Dashboard build path (for production)
VITE_API_URL=/api
