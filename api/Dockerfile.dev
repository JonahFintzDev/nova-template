# Development Dockerfile for API
FROM node:24

WORKDIR /app

# Copy entrypoint outside /app so the source volume mount doesn't shadow it
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev)
RUN npm ci

# Copy source files
COPY . .

# Generate Prisma client
RUN npx prisma generate

# Expose port
EXPOSE 3000

ENTRYPOINT ["/entrypoint.sh"]
CMD ["npm", "run", "dev"]
