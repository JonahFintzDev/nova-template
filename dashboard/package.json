{
  "name": "nova-template-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "maintainers": [
    {
      "name": "Jonah Fintz",
      "email": "jonah@fintz.dev"
    }
  ],
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache --ignore-pattern public/",
    "format": "prettier --write src/ --ignore-path .gitignore --ignore-path .prettierignore",
    "format-check": "prettier --check src/ --ignore-path .gitignore --ignore-path .prettierignore"
  },
  "dependencies": {
    "@vuepic/vue-datepicker": "^13.0.0",
    "axios": "^1.16.1",
    "dayjs": "^1.11.21",
    "gsap": "^3.15.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "uuid": "^14.0.0",
    "vue": "^3.5.35",
    "vue-color": "^3.3.3",
    "vue-i18n": "^11.4.4",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.1",
    "npm-run-all2": "^9.0.1",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.3"
  }
}
